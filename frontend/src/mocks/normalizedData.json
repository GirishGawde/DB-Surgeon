    { "from": "orders.customer_id", "to": "customers.id", "type": "1:N" },
    { "from": "orders.shipping_address_id", "to": "addresses.id", "type": "N:1" },
    { "from": "order_items.order_id", "to": "orders.id", "type": "1:N" }
  ],
  "proposedSql": "-- 1. Enable Foreign Key Constraints\nPRAGMA foreign_keys = ON;\n\n-- 2. Create Normalized Tables\nCREATE TABLE customers (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    full_name TEXT NOT NULL,\n    phone_e164 TEXT,\n    aadhar_masked TEXT NOT NULL\n);\n\nCREATE TABLE addresses (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    customer_id INTEGER NOT NULL REFERENCES customers(id),\n    street_address TEXT NOT NULL,\n    locality TEXT,\n    city TEXT NOT NULL,\n    state TEXT NOT NULL,\n    pincode TEXT NOT NULL\n);\n\nCREATE TABLE orders (\n    id INTEGER PRIMARY KEY,\n    customer_id INTEGER NOT NULL REFERENCES customers(id),\n    shipping_address_id INTEGER NOT NULL REFERENCES addresses(id),\n    order_date TEXT NOT NULL,\n    total_amount REAL NOT NULL\n);\n\nCREATE TABLE order_items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    order_id INTEGER NOT NULL REFERENCES orders(id),\n    item_name TEXT NOT NULL,\n    unit_price REAL NOT NULL,\n    quantity INTEGER DEFAULT 1\n);\n\n-- 3. Populate Normalized 3NF Schema & Mask PII\nINSERT INTO customers (full_name, phone_e164, aadhar_masked)\nSELECT DISTINCT \n    customer_name,\n    CASE \n        WHEN customer_phone LIKE '+91%' THEN REPLACE(REPLACE(customer_phone, '-', ''), ' ', '')\n        ELSE '+91' || SUBSTR(REPLACE(REPLACE(customer_phone, '-', ''), ' ', ''), -10)\n    END,\n    'XXXX-XXXX-' || SUBSTR(aadhar_number, -4)\nFROM messy_orders;"
}
