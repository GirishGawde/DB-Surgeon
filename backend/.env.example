# ============================================================================
# MongoMind / DB-Surgeon Backend Environment Configuration
# ============================================================================

# Server Configuration
PORT=3000

# MongoDB Connection URL (Local or Atlas)
MONGO_URL=mongodb://localhost:27017/mongomind

# Google Gemini / Gemma 4 API Key (REQUIRED)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Email Notification Service (Optional / Alert Dispatcher)
EMAIL=your_email@gmail.com
CLIENT_ID=your_oauth2_client_id
CLIENT_SECRET=your_oauth2_client_secret
REFRESH_TOKEN=your_oauth2_refresh_token

# ImageKit Storage Configuration (Optional / Diagram Ingestion)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint
